*.vscdb
*.vscdb.backup
state.vscdb*
Cookies
Cookies-journal
Local State
Network Persistent State
**/User/globalStorage/
**/user-data/

# Machine-local tool settings
.claude/
.vscode/settings.json

# Credentials and secrets
.env
.env.*
*.pem
*.pfx
*.p12
*.key
secrets.json
credentials.json
auth.json
session-state.json

# Temporary files and logs
*.tmp
*.log
*.corrupt-*
~$*

# Operating system files
Thumbs.db
desktop.ini
.DS_Store
